<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- Fundo preto: sem flash branco atrás das telas. -->
        <item name="android:windowBackground">@color/app_background</item>
    </style>

    <!--
      Abertura (react-native-bootsplash): fundo preto e o ícone `splash_icon`
      (288 dp com o logo em 200 dp, o maior tamanho que cabe no círculo de
      192 dp da SplashScreen do Android 12+). O splash fica até o JS chamar
      BootSplash.hide(); depois a MainActivity usa o AppTheme.
    -->
    <style name="BootTheme" parent="Theme.BootSplash">
        <item name="bootSplashBackground">@color/app_background</item>
        <item name="bootSplashLogo">@drawable/splash_icon</item>
        <item name="darkContentBarsStyle">false</item>
        <item name="postBootSplashTheme">@style/AppTheme</item>
    </style>

</resources>
