{
  "name": "FiapSchoolMobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android --active-arch-only",
    "android:release": "react-native run-android --mode release --active-arch-only",
    "ios": "react-native run-ios --simulator \"iPhone 17\"",
    "ios:device": "react-native run-ios --device",
    "ios:release": "react-native run-ios --device --mode Release",
    "ios:pods": "cd ios && pod install",
    "lint": "eslint .",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/restyle": "^2.4.5",
    "axios": "1.20.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-bootsplash": "7.3.3",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-keychain": "10.0.0",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.11.1",
    "react-native-screens": "^4.30.1",
    "react-native-svg": "^15.16.0",
    "react-native-worklets": "^0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-inline-environment-variables": "0.4.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "packageManager": "yarn@1.22.22"
}
